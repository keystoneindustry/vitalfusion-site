# Vital Fusion coaching app — environment variables (set these in the Vercel project).

# Supabase project "VFCoaching App" → Project Settings → API Keys
SUPABASE_URL=https://bcwytsuqudwghxctxoef.supabase.co
# Publishable key (safe to share; starts with sb_publishable_)
SUPABASE_PUBLISHABLE_KEY=
# Secret key (server only, NEVER share; starts with sb_secret_)
SUPABASE_SECRET_KEY=

# Resend → API Keys (sending access is enough)
RESEND_API_KEY=
# Sender for invite and sign-in emails (domain must be verified in Resend)
FROM_EMAIL=Vital Fusion Coaching <coaching@vitalfusioncoaching.com>
# Where client replies go
REPLY_TO_EMAIL=tyler@vitalfusioncoaching.com

# Email addresses that sign in as the coach (comma-separated)
COACH_EMAILS=tyler@vitalfusioncoaching.com

# Optional: public address of the app, e.g. https://app.vitalfusioncoaching.com.
# Leave blank to use whatever address the app was opened on.
APP_URL=
