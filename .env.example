# --- Required: email notifications (https://resend.com → API Keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where new applications are sent (you)
NOTIFY_EMAIL=keystoneindustry@gmail.com
# Sender. "onboarding@resend.dev" works immediately, but only delivers to the
# email you signed up to Resend with. After verifying vitalfusioncoaching.com
# in Resend, change to e.g. "Vital Fusion <apply@vitalfusioncoaching.com>".
FROM_EMAIL=Vital Fusion Coaching <onboarding@resend.dev>
# Send the applicant a "we got your application" email (needs a verified domain)
SEND_APPLICANT_CONFIRMATION=false

# --- Optional: save every application to a database (https://supabase.com) ---
# Leave blank to skip. Run supabase/schema.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
